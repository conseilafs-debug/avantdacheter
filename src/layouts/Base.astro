---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string; // chemin canonique (avec slash final)
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, path = Astro.url.pathname, type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const site = (Astro.site ?? new URL('https://avantdacheter.pages.dev')).toString().replace(/\/$/, '');
const canonical = site + path;
const fullTitle = title.includes(SITE.name) || title.length > 46 ? title : `${title} | ${SITE.name}`;
const og = `${site}/og.png`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="google-site-verification" content="8Eum5sM8CKG_pU2vkQdgZWC1FIMhZrVIEEI3VE8otf8" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
      <script>import "../scripts/search";</script>
  </body>
</html>
