---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/GuideCard.astro';
import { CATS } from '../../data/taxonomy';
import { clustersOfCat, guidesOfCat, guidesOfCluster } from '../../lib/guides';
import { breadcrumbLd } from '../../lib/seo';

export function getStaticPaths() {
  return CATS.filter((c) => guidesOfCat(c.slug).length > 0).map((c) => ({ params: { cat: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const clusters = clustersOfCat(cat.slug);
const total = guidesOfCat(cat.slug).length;
const url = `/${cat.slug}/`;
const crumbs = [{ name: 'Accueil', url: '/' }, { name: cat.name, url }];
const title = `${cat.name} : guides d'achat pour bien choisir`;
---
<Base title={title} description={`${cat.desc} ${total} guides pratiques.`} path={url} jsonLd={[breadcrumbLd(Astro.site, crumbs)]}>
  <div class="wrap article">
    <Breadcrumb items={crumbs} />
    <h1>{cat.name} : les guides pour bien choisir</h1>
    <p class="lead">{cat.desc}</p>
    <p class="note">Rubriques prévues : {cat.subs.join(' · ')}. De nouveaux guides sont ajoutés régulièrement.</p>
    {clusters.map((c) => (
      <section class="block">
        <div class="sec-head"><h2>{c.name}</h2><a href={`/${cat.slug}/${c.slug}/`}>Voir le dossier {c.name.toLowerCase()} →</a></div>
        <div class="grid grid-2">{guidesOfCluster(c.slug).map((g) => <GuideCard guide={g} />)}</div>
      </section>
    ))}
  </div>
</Base>
