---
import type { Cat } from '../data/taxonomy';
interface Props { cat: Cat; count: number; }
const { cat, count } = Astro.props;
---
<a class="card cat-card" href={`/${cat.slug}/`}>
  <span class="cat-icon" aria-hidden="true">{cat.icon}</span>
  <span class="card-title">{cat.name}</span>
  <span class="card-text">{cat.desc}</span>
  <span class="card-meta">{count} guide{count > 1 ? 's' : ''}</span>
</a>
