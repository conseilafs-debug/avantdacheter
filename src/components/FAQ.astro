---
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Questions fréquentes</h2>
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <p>{it.a}</p>
    </details>
  ))}
</section>
