---
import { CATS, TYPES } from '../data/taxonomy';
import { SITE } from '../config';
const footTypes = TYPES.filter((t) => ['taille', 'capacite', 'budget', 'verifier', 'accessoires'].includes(t.key));
const info = [
  ['À propos', '/a-propos/'],
  ['Notre fonctionnement', '/notre-fonctionnement/'],
  ['Contact', '/contact/'],
  ['Mentions légales', '/mentions-legales/'],
  ['Confidentialité', '/politique-de-confidentialite/'],
  ['Cookies', '/politique-de-cookies/'],
  ["Conditions d'utilisation", '/conditions-utilisation/'],
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <section aria-labelledby="f1">
        <h2 id="f1">Guides d'achat</h2>
        <ul>{CATS.map((c) => <li><a href={`/${c.slug}/`}>{c.short}</a></li>)}</ul>
      </section>
      <section aria-labelledby="f2">
        <h2 id="f2">Conseils</h2>
        <ul>{footTypes.map((t) => <li><a href={`/conseils/${t.slug}/`}>{t.title}</a></li>)}</ul>
      </section>
      <section aria-labelledby="f3">
        <h2 id="f3">Informations</h2>
        <ul>{info.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </section>
    </div>
    <p class="foot-note"><strong>{SITE.name}</strong> — {SITE.slogan}. Site indépendant, non affilié à Amazon. En tant que Partenaire Amazon, nous réalisons un bénéfice sur les achats remplissant les conditions requises. Les marques citées appartiennent à leurs propriétaires respectifs.</p>
    <p class="foot-note">© {new Date().getFullYear()} {SITE.name}</p>
  </div>
</footer>
